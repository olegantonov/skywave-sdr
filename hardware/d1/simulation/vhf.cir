SkyWave vhf nominal LPF; ideal LC, 50 ohm terminations
V1 source 0 AC 1
RS source n0 50
RL n3 0 50
C1 n0 0 7.5p
L1 n0 n1 47n
C2 n1 0 30p
L2 n1 n2 82n
C3 n2 0 30p
L3 n2 n3 47n
C4 n3 0 7.5p
.control
set wr_singlescale
set wr_vecnames
ac dec 150 48000000.0 592000000.0
let s21_db = db(v(n3)*2)
wrdata vhf.dat s21_db
quit
.endc
.end
