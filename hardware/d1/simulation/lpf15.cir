SkyWave lpf15 nominal LPF; ideal LC, 50 ohm terminations
V1 source 0 AC 1
RS source n0 50
RL n3 0 50
C1 n0 0 51p
L1 n0 n1 390n
C2 n1 0 200p
L2 n1 n2 680n
C3 n2 0 200p
L3 n2 n3 390n
C4 n3 0 51p
.control
set wr_singlescale
set wr_vecnames
ac dec 150 7000000.0 85800000.0
let s21_db = db(v(n3)*2)
wrdata lpf15.dat s21_db
quit
.endc
.end
