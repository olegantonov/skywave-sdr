SkyWave lpf10 nominal LPF; ideal LC, 50 ohm terminations
V1 source 0 AC 1
RS source n0 50
RL n3 0 50
C1 n0 0 36p
L1 n0 n1 270n
C2 n1 0 150p
L2 n1 n2 470n
C3 n2 0 150p
L3 n2 n3 270n
C4 n3 0 36p
.control
set wr_singlescale
set wr_vecnames
ac dec 150 9333333.333333334 118800000.0
let s21_db = db(v(n3)*2)
wrdata lpf10.dat s21_db
quit
.endc
.end
