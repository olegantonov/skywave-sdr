SkyWave lpf20 nominal LPF; ideal LC, 50 ohm terminations
V1 source 0 AC 1
RS source n0 50
RL n3 0 50
C1 n0 0 75p
L1 n0 n1 560n
C2 n1 0 300p
L2 n1 n2 1000n
C3 n2 0 300p
L3 n2 n3 560n
C4 n3 0 75p
.control
set wr_singlescale
set wr_vecnames
ac dec 150 4666666.666666667 57400000.0
let s21_db = db(v(n3)*2)
wrdata lpf20.dat s21_db
quit
.endc
.end
